<resources>
    <style name="Theme.Hotseat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/sky</item>
    </style>

    <!-- the system splash: the bird asleep on its sticker, exactly where the intro animation starts -->
    <style name="Theme.Hotseat.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sky</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Hotseat</item>
    </style>
</resources>
