{
  "name": "hotseat-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "dev": { "port": 8790 },
  // per device limits, a session every 20s and a few reports a minute is plenty for one person
  "ratelimits": [
    { "name": "SESSION_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "REPORT_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ]
}
